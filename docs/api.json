{
  "components": {
    "schemas": {
      "server": {
        "properties": {
          "alias": {
            "example": [
              "my-server-alias",
              "production-server"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "example": 1,
            "format": "int64",
            "type": "integer"
          },
          "ip": {
            "example": "192.168.1.1",
            "format": "ipv4",
            "type": "string"
          },
          "name": {
            "example": "imi-server-01",
            "format": "string",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "name",
          "ip",
          "alias"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "OIDC": {
        "description": "OpenID Connect (OIDC) authentication via Keycloak. Client ID: client-imi. Click 'Authorize' to login.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "http://localhost:8080/realms/imi-realm/protocol/openid-connect/auth",
            "refreshUrl": "http://localhost:8080/realms/imi-realm/protocol/openid-connect/token",
            "scopes": {
              "email": "User email",
              "openid": "OpenID Connect",
              "profile": "User profile information"
            },
            "tokenUrl": "http://localhost:8080/realms/imi-realm/protocol/openid-connect/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "description": "This is an RESTful API spec for the IMI Server Manager application.",
    "title": "IMI Server Manager",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/server": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/server"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of all servers"
          },
          "401": {
            "description": "Unauthorized - invalid or missing authentication token"
          }
        },
        "security": [
          {
            "OIDC": []
          }
        ],
        "summary": "List all servers",
        "tags": [
          "Server"
        ]
      },
      "post": {
        "description": "Can accept either a single server object or an array of multiple servers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "description": "Single server object",
                    "properties": {
                      "alias": {
                        "example": [
                          "server-alias-1",
                          "server-alias-2"
                        ],
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "ip": {
                        "example": "192.168.1.1",
                        "format": "ipv4",
                        "type": "string"
                      },
                      "name": {
                        "example": "imi-server-01",
                        "type": "string"
                      }
                    },
                    "required": [
                      "ip",
                      "name",
                      "alias"
                    ],
                    "type": "object"
                  },
                  {
                    "description": "Multiple server objects",
                    "example": [
                      {
                        "alias": [
                          "alias-1"
                        ],
                        "ip": "192.168.1.1",
                        "name": "imi-server-01"
                      },
                      {
                        "alias": [
                          "alias-2"
                        ],
                        "ip": "192.168.1.2",
                        "name": "imi-server-02"
                      }
                    ],
                    "items": {
                      "properties": {
                        "alias": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "ip": {
                          "format": "ipv4",
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "ip",
                        "name",
                        "alias"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/server",
                    "description": "Single server response"
                  },
                  {
                    "description": "Multiple servers response",
                    "items": {
                      "$ref": "#/components/schemas/server"
                    },
                    "type": "array"
                  }
                ]
              }
            },
            "description": "Server(s) created successfully"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "detail": {
                      "example": "Invalid IP address format",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Invalid input - check request parameters"
          },
          "401": {
            "description": "Unauthorized - invalid or missing authentication token"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "detail": {
                      "example": "Server with IP 192.168.1.1 already exists",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Conflict - server with this IP or name already exists"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "detail": {
                      "example": [
                        {
                          "field": "ip",
                          "message": "field required"
                        }
                      ],
                      "items": {
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Validation error - missing required fields"
          }
        },
        "security": [
          {
            "OIDC": []
          }
        ],
        "summary": "Add one or multiple servers to the system",
        "tags": [
          "Server"
        ]
      }
    },
    "/api/server/{server_id}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "server_id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Server deleted successfully"
          },
          "401": {
            "description": "Unauthorized - invalid or missing authentication token"
          },
          "404": {
            "description": "Server not found"
          }
        },
        "security": [
          {
            "OIDC": []
          }
        ],
        "summary": "Delete a server",
        "tags": [
          "Server"
        ]
      },
      "get": {
        "parameters": [
          {
            "example": 12345,
            "in": "path",
            "name": "server_id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/server"
                }
              }
            },
            "description": "Server details"
          },
          "401": {
            "description": "Unauthorized - invalid or missing authentication token"
          },
          "404": {
            "description": "Server not found"
          }
        },
        "security": [
          {
            "OIDC": []
          }
        ],
        "summary": "Get server details by ID",
        "tags": [
          "Server"
        ]
      },
      "put": {
        "parameters": [
          {
            "in": "path",
            "name": "server_id",
            "required": true,
            "schema": {
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "alias": {
                    "example": [
                      "updated-alias"
                    ],
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "ip": {
                    "example": "192.168.1.5",
                    "format": "ipv4",
                    "type": "string"
                  },
                  "name": {
                    "example": "imi-server-updated",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/server"
                }
              }
            },
            "description": "Server updated successfully"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized - invalid or missing authentication token"
          },
          "404": {
            "description": "Server not found"
          },
          "409": {
            "description": "Conflict - IP or name already exists"
          }
        },
        "security": [
          {
            "OIDC": []
          }
        ],
        "summary": "Update an existing server",
        "tags": [
          "Server"
        ]
      }
    },
    "/api/user": {
      "get": {
        "description": "Returns a list of all users with their public keys and assigned servers.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "created_at": {
                        "format": "date-time",
                        "type": "string"
                      },
                      "id": {
                        "example": 1,
                        "type": "integer"
                      },
                      "keycloak_id": {
                        "example": "123e4567-e89b-12d3-a456-426614174000",
                        "type": "string"
                      },
                      "pubKey": {
                        "example": [
                          "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA..."
                        ],
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "assigned_servers_count": {
                        "description": "Number of servers this user has access to",
                        "example": 3,
                        "type": "integer"
                      },
                      "assigned_servers": {
                        "description": "List of servers this user has access to with assignment timestamps",
                        "items": {
                          "properties": {
                            "id": {
                              "type": "integer"
                            },
                            "name": {
                              "type": "string"
                            },
                            "ip": {
                              "type": "string"
                            },
                            "assigned_at": {
                              "format": "date-time",
                              "type": "string"
                            },
                            "assignment_updated_at": {
                              "format": "date-time",
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "updated_at": {
                        "format": "date-time",
                        "type": "string"
                      },
                      "username": {
                        "example": "imi-user-01",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of all users"
          },
          "401": {
            "description": "Unauthorized - invalid or missing authentication token"
          }
        },
        "security": [
          {
            "OIDC": []
          }
        ],
        "summary": "List all users",
        "tags": [
          "User"
        ]
      }
    },
    "/api/user/{keycloak_id}": {
      "get": {
        "description": "Returns user details including public keys and all servers assigned to the user",
        "parameters": [
          {
            "in": "path",
            "name": "keycloak_id",
            "required": true,
            "schema": {
              "example": "123e4567-e89b-12d3-a456-426614174000",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "created_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "id": {
                      "example": 1,
                      "type": "integer"
                    },
                    "keycloak_id": {
                      "example": "123e4567-e89b-12d3-a456-426614174000",
                      "type": "string"
                    },
                    "pubKey": {
                      "example": [
                        "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA..."
                      ],
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "assigned_servers": {
                      "description": "List of servers this user has access to",
                      "example": [
                        {
                          "id": 1,
                          "name": "imi-server-01",
                          "ip": "192.168.1.1",
                          "created_at": "2024-01-01T00:00:00Z",
                          "updated_at": "2024-01-01T00:00:00Z"
                        }
                      ],
                      "items": {
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "name": {
                            "type": "string"
                          },
                          "ip": {
                            "type": "string"
                          },
                          "assigned_at": {
                            "format": "date-time",
                            "type": "string"
                          },
                          "assignment_updated_at": {
                            "format": "date-time",
                            "type": "string"
                          },
                          "created_at": {
                            "format": "date-time",
                            "type": "string"
                          },
                          "updated_at": {
                            "format": "date-time",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "updated_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "username": {
                      "example": "imi-user-01",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "User details with assigned servers"
          },
          "401": {
            "description": "Unauthorized - invalid or missing authentication token"
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "OIDC": []
          }
        ],
        "summary": "Get user details",
        "tags": [
          "User"
        ]
      }
    },
    "/api/user/assign": {
      "post": {
        "description": "Assigns a user to a server. Requires admin role.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "server_id": {
                    "example": 12345,
                    "type": "integer"
                  },
                  "user_id": {
                    "example": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "user_id",
                  "server_id"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "example": "User assigned to server successfully",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "User assigned to server successfully"
          },
          "400": {
            "description": "Invalid input - check user_id and server_id"
          },
          "401": {
            "description": "Unauthorized - invalid or missing authentication token"
          },
          "403": {
            "description": "Forbidden - requires admin role"
          },
          "404": {
            "description": "User or server not found"
          }
        },
        "security": [
          {
            "OIDC": []
          }
        ],
        "summary": "Assign user to server",
        "tags": [
          "User"
        ]
      }
    },
    "/api/user/unassign": {
      "post": {
        "description": "Removes a user's access to a server by deleting the association. Requires admin role.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "server_id": {
                    "example": 12345,
                    "type": "integer"
                  },
                  "user_id": {
                    "example": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "user_id",
                  "server_id"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "example": "User removed from server successfully",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "User removed from server successfully"
          },
          "400": {
            "description": "Invalid input - check user_id and server_id"
          },
          "401": {
            "description": "Unauthorized - invalid or missing authentication token"
          },
          "403": {
            "description": "Forbidden - requires admin role"
          },
          "404": {
            "description": "User not found, server not found, or user is not assigned to this server"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "OIDC": []
          }
        ],
        "summary": "Remove user from server",
        "tags": [
          "User"
        ]
      }
    },
    "/api/user/sync": {
      "get": {
        "description": "Fetches users from Keycloak and updates the local database. Returns synchronization summary or a no-op message.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "properties": {
                        "added_users": {
                          "items": {
                            "properties": {
                              "keycloak_id": {
                                "example": "2e9f1edd-f49c-4c49-bba1-26f1b8f64aed",
                                "type": "string"
                              },
                              "pubkeys_count": {
                                "example": 1,
                                "type": "integer"
                              },
                              "username": {
                                "example": "imi-user-01",
                                "type": "string"
                              }
                            },
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "updated_users": {
                          "items": {
                            "properties": {
                              "changes": {
                                "items": {
                                  "type": "string"
                                },
                                "type": "array"
                              },
                              "keys_added": {
                                "example": 1,
                                "type": "integer"
                              },
                              "keys_removed": {
                                "example": 0,
                                "type": "integer"
                              },
                              "username": {
                                "example": "imi-user-02",
                                "type": "string"
                              }
                            },
                            "type": "object"
                          },
                          "type": "array"
                        },
                        "deleted_users": {
                          "items": {
                            "properties": {
                              "username": {
                                "type": "string"
                              },
                              "keycloak_id": {
                                "type": "string"
                              }
                            },
                            "type": "object"
                          },
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "properties": {
                        "message": {
                          "example": "All users are already synchronized",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Users synchronized successfully"
          },
          "401": {
            "description": "Unauthorized - invalid or missing authentication token"
          },
          "403": {
            "description": "Forbidden - requires admin role"
          },
          "500": {
            "description": "Internal server error during synchronization"
          }
        },
        "security": [
          {
            "OIDC": []
          }
        ],
        "summary": "Sync users from Keycloak",
        "tags": [
          "User"
        ]
      }
    },
    "/api/activity/status": {
      "get": {
        "description": "Returns the latest synchronization timestamp and the latest update timestamp across POST/PUT operations.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "last_synced": {
                      "format": "date-time",
                      "nullable": true,
                      "type": "string"
                    },
                    "last_updated": {
                      "format": "date-time",
                      "nullable": true,
                      "type": "string"
                    },
                    "server_time": {
                      "format": "date-time",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Activity timestamps fetched successfully"
          },
          "401": {
            "description": "Unauthorized - invalid or missing authentication token"
          },
          "403": {
            "description": "Forbidden - requires read-only-role"
          }
        },
        "security": [
          {
            "OIDC": []
          }
        ],
        "summary": "Get latest sync and update timestamps",
        "tags": [
          "Activity Logs"
        ]
      }
    },
    "/api/blacklist": {
      "get": {
        "description": "Returns a list of blacklisted users that are blocked from accessing specific servers.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "properties": {
                      "id": {
                        "example": 1,
                        "type": "integer"
                      },
                      "username": {
                        "example": "test-user",
                        "type": "string"
                      },
                      "servers": {
                         "example": [
                          "12345",
                          "67890"
                        ],
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "created_at": {
                        "format": "date-time",
                        "type": "string"
                      },
                      "updated_at": {
                        "format": "date-time",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Blacklisted users fetched successfully"
          },
          "401": {
            "description": "Unauthorized - invalid or missing authentication token"
          },
          "403": {
            "description": "Forbidden - requires read-only-role"
          }
        },
        "security": [
          {
            "OIDC": []
          }
        ],
        "summary": "Get Blacklisted Users",
        "tags": [
          "Blacklist"
        ]
      },
      "post": {
        "description": "Adds a user to the blacklist for a specific server, preventing them from accessing it.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "server_id": {
                    "example": 12345,
                    "type": "integer"
                  },
                  "username": {
                    "example": "test-user",
                    "type": "string"
                  }
                },
                "required": [
                  "username",
                  "server_id"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "username": {
                      "type": "string"
                    },
                    "server_id": {
                      "type": "integer"
                    },
                    "created_at": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "updated_at": {
                      "format": "date-time",
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "User added to blacklist successfully"
